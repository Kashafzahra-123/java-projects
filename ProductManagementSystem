import java.util.Scanner;

public class ProductManagementSystem {
    private String productId;
    private String productTitle;
    private double productCost;
    private int stockQuantity;
    private boolean available = false;

    // Add new product manually
    public void insertProduct(Scanner sc) {
        System.out.print("Enter Product ID: ");
        productId = sc.nextLine();
        System.out.print("Enter Product Title: ");
        productTitle = sc.nextLine();
        System.out.print("Enter Product Cost: ");
        productCost = sc.nextDouble();
        System.out.print("Enter Stock Quantity: ");
        stockQuantity = sc.nextInt();
        sc.nextLine();
        available = true;
        System.out.println("\n Product has been added successfully!\n");
    }

    // Display product information
    public void viewProduct() {
        if (!available) {
            System.out.println(" No product found. Please add a product first.\n");
        } else {
            System.out.println("------- Product Details -------");
            System.out.println("Product ID: " + productId);
            System.out.println("Title: " + productTitle);
            System.out.println("Cost: " + productCost);
            System.out.println("Quantity: " + stockQuantity);
            System.out.println("--------------------------------\n");
        }
    }

    // Search for a product
    public void searchProduct(Scanner sc) {
        if (!available) {
            System.out.println(" No product available to search.\n");
            return;
        }
        System.out.print("Enter Product ID to search: ");
        String searchId = sc.nextLine();
        if (searchId.equals(productId)) {
            System.out.println("\nProduct Found!\n");
            viewProduct();
        } else {
            System.out.println("\n Product not found.\n");
        }
    }

    // Delete existing product
    public void deleteProduct() {
        if (!available) {
            System.out.println(" No product available to delete.\n");
        } else {
            available = false;
            System.out.println(" Product deleted successfully.\n");
        }
    }

    // Load example product data
    public void loadSampleData() {
        productId = "P2025";
        productTitle = "Marker";
        productCost = 120.75;
        stockQuantity = 30;
        available = true;
        System.out.println("Sample Product Loaded:\n");
        System.out.println("Product ID: " + productId);
        System.out.println("Title: " + productTitle);
        System.out.println("Cost: " + productCost);
        System.out.println("Quantity: " + stockQuantity);
        System.out.println("");
    }

    // Main menu
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        ProductManagementSystem system = new ProductManagementSystem();
        int choice;

        do {
            System.out.println("====== Simple Product Management System ======");
            System.out.println("1. Add Product (Manual Entry)");
            System.out.println("2. Load Sample Product");
            System.out.println("3. View Product Details");
            System.out.println("4. Search Product by ID");
            System.out.println("5. Delete Product");
            System.out.println("6. Exit");
            System.out.print("Enter your choice: ");
            choice = sc.nextInt();
            sc.nextLine();
            System.out.println("");

            switch (choice) {
                case 1:
                    system.insertProduct(sc);
                    break;
                case 2:
                    system.loadSampleData();
                    break;
                case 3:
                    system.viewProduct();
                    break;
                case 4:
                    system.searchProduct(sc);
                    break;
                case 5:
                    system.deleteProduct();
                    break;
                case 6:
                    System.out.println(" Exiting Program... Thank you!");
                    break;
                default:
                    System.out.println(" Invalid option, please try again.\n");
            }
        } while (choice != 6);
        sc.close();
    }
}
